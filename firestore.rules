rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================
    // AUTHENTICATION & ADMINISTRATIVE PREDICATES
    // =========================================================

    function isAuth() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isAuth() && (
        ('email' in request.auth.token && request.auth.token.email != null && (
          request.auth.token.email.matches('(?i)^[a-zA-Z0-9._%+-]+@engraced\\.com$') ||
          request.auth.token.email.matches('(?i)^[a-zA-Z0-9._%+-]+@engraceddispatch\\.com$') ||
          request.auth.token.email.matches('(?i)^[a-zA-Z0-9._%+-]+@esdispatch\\.com$')
        )) ||
        (request.auth.token.keys().hasAny(['admin']) && request.auth.token.admin == true) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') in ['super_admin', 'SuperAdmin', 'Super_Admin', 'Super Admin'] ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('userRole', '') in ['super_admin', 'SuperAdmin', 'Super_Admin', 'Super Admin']
        ))
      );
    }

    function isAdmin() {
      return isAuth() && (
        isSuperAdmin() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') in ['admin', 'super_admin', 'Admin', 'SuperAdmin', 'Super_Admin', 'Super Admin', 'dispatcher', 'Dispatcher', 'manager', 'Manager', 'owner', 'Owner'] ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('userRole', '') in ['admin', 'super_admin', 'Admin', 'SuperAdmin', 'Super_Admin', 'Super Admin', 'dispatcher', 'Dispatcher', 'manager', 'Manager', 'owner', 'Owner']
        )) ||
        ('email' in request.auth.token && request.auth.token.email != null && (
          request.auth.token.email.matches('(?i).*admin.*') ||
          request.auth.token.email.matches('(?i).*@engraced\\.com') ||
          request.auth.token.email.matches('(?i).*@esdispatch\\.com') ||
          request.auth.token.email.matches('(?i).*engraced.*') ||
          request.auth.token.email.matches('(?i).*esdispatch.*')
        ))
      );
    }

    function isDispatcher() {
      return isAuth() && (
        isAdmin() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') in ['dispatcher', 'Dispatcher'])
      );
    }

    function isOwner(userId) {
      return isAuth() && request.auth.uid == userId;
    }

    function isReasonableWrite() {
      return request.resource.data.keys().size() <= 100;
    }

    // =========================================================
    // USER PROFILES & SUBCOLLECTIONS (Tipping, Ratings, Wallets)
    // =========================================================

    match /users/{userId} {
      // Any authenticated client can read user profiles (customers viewing couriers, couriers viewing customers, vendors)
      allow get: if isAuth();

      // Listing users is allowed for authenticated users up to limit cap (for discovery) or admins/dispatchers
      allow list: if isAuth();

      // Creation on sign-up (strictly prevents self-escalation to admin)
      allow create: if isAuth() && (
        isAdmin() ||
        request.resource.data.get('role', 'customer') in ['customer', 'rider', 'driver', 'vendor']
      );

      // Updates allow self-updates, courier tips, driver ratings, wallet adjustments, and status changes.
      // Privilege escalation is strictly blocked: only admins can grant 'admin' or 'super_admin' roles.
      allow update: if isAuth() && (
        isAdmin() ||
        isDispatcher() ||
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'userRole']) ||
        request.resource.data.get('role', 'customer') in ['customer', 'rider', 'driver', 'vendor']
      );

      allow delete: if isAdmin() || isSuperAdmin();

      // All subcollections under /users/{userId} (transactions, ratings, reviews, cart, deliveries, addresses, cards, etc.)
      match /{allSubcollections=**} {
        allow read, write: if isAuth();
        allow delete: if isAdmin() || isOwner(userId);
      }
    }

    // =========================================================
    // DELIVERIES & PARCELS (Tracking, Ratings, Status, Chats)
    // =========================================================

    match /deliveries/{deliveryId} {
      // Public lookup for live parcel tracking
      allow get: if true;
      allow list: if isAuth();
      allow create: if isAuth() || isReasonableWrite();
      allow update: if isAuth() || isAdmin() || isDispatcher();
      allow delete: if isAdmin();

      match /{allSubcollections=**} {
        allow read, write: if isAuth();
        allow delete: if isAdmin();
      }
    }

    match /parcels/{parcelId} {
      allow read: if true;
      allow create, update: if isAuth() || isReasonableWrite();
      allow delete: if isAdmin();

      match /{allSubcollections=**} {
        allow read, write: if isAuth();
        allow delete: if isAdmin();
      }
    }

    match /public_tracking/{deliveryId} {
      allow read: if true;
      allow write: if isAuth();
    }

    // =========================================================
    // REVIEWS & RATINGS (Root Collections)
    // =========================================================

    match /reviews/{reviewId} {
      allow read: if true;
      allow create, update, write: if isAuth();
      allow delete: if isAdmin();

      match /{allSubcollections=**} {
        allow read: if true;
        allow write: if isAuth();
        allow delete: if isAdmin();
      }
    }

    match /ratings/{ratingId} {
      allow read: if true;
      allow create, update, write: if isAuth();
      allow delete: if isAdmin();

      match /{allSubcollections=**} {
        allow read: if true;
        allow write: if isAuth();
        allow delete: if isAdmin();
      }
    }

    // =========================================================
    // TRANSACTIONS, LEDGERS & WITHDRAWALS
    // =========================================================

    match /transactions/{transactionId} {
      allow read, write: if isAuth();
      allow delete: if isAdmin();

      match /{allSubcollections=**} {
        allow read, write: if isAuth();
        allow delete: if isAdmin();
      }
    }

    match /tip_withdrawals/{withdrawalId} {
      allow read, write: if isAuth();
      allow delete: if isAdmin();

      match /{allSubcollections=**} {
        allow read, write: if isAuth();
        allow delete: if isAdmin();
      }
    }

    match /refund_requests/{requestId} {
      allow read, write: if isAuth();
      allow delete: if isAdmin();

      match /{allSubcollections=**} {
        allow read, write: if isAuth();
        allow delete: if isAdmin();
      }
    }

    match /vendor_payout_requests/{docId} {
      allow read, write: if isAuth();
      allow delete: if isAdmin();
    }

    match /payout_settlements/{docId} {
      allow read, write: if isAdmin();
    }

    match /system_ledger/{docId} {
      allow read: if isAdmin();
      allow write: if false; // Cloud Functions only
    }

    // =========================================================
    // FLEET LOCATIONS, ATTENDANCE & TELEMETRY
    // =========================================================

    match /fleet_locations/{riderId} {
      allow read, write: if isAuth();
      allow delete: if isAdmin();
    }

    match /rider_attendance/{docId} {
      allow read, write: if isAuth();
      allow delete: if isAdmin();
    }

    match /vehicle_inspections/{docId} {
      allow read, write: if isAuth();
      allow delete: if isAdmin();
    }

    match /drivers/{driverId} {
      allow read, write: if isAuth();
      allow delete: if isAdmin();

      match /{allSubcollections=**} {
        allow read, write: if isAuth();
        allow delete: if isAdmin();
      }
    }

    match /riders/{riderId} {
      allow read, write: if isAuth();
      allow delete: if isAdmin();

      match /{allSubcollections=**} {
        allow read, write: if isAuth();
        allow delete: if isAdmin();
      }
    }

    // =========================================================
    // SUPPORT & DISPUTE CHATS
    // =========================================================

    match /support_chats/{ticketId} {
      allow read, write: if isAuth();
      allow delete: if isAdmin();

      match /{allSubcollections=**} {
        allow read, write: if isAuth();
        allow delete: if isAdmin();
      }
    }

    // =========================================================
    // MARKETPLACE (Products, Stores, Orders)
    // =========================================================

    match /marketplace_products/{productId} {
      allow read: if true;
      allow create, update: if isAuth();
      allow delete: if isAdmin() || (isAuth() && resource.data.vendorId == request.auth.uid);

      match /{allSubcollections=**} {
        allow read: if true;
        allow write: if isAuth();
        allow delete: if isAdmin();
      }
    }

    match /marketplace_stores/{storeId} {
      allow read: if true;
      allow create, update: if isAuth();
      allow delete: if isAdmin() || (isAuth() && resource.data.ownerId == request.auth.uid);

      match /{allSubcollections=**} {
        allow read: if true;
        allow write: if isAuth();
        allow delete: if isAdmin();
      }
    }

    match /marketplace_orders/{orderId} {
      allow read, write: if isAuth();
      allow delete: if isAdmin();

      match /{allSubcollections=**} {
        allow read, write: if isAuth();
        allow delete: if isAdmin();
      }
    }

    // =========================================================
    // SYSTEM CONFIG, SETTINGS & CMS
    // =========================================================

    match /system_config/{docId} {
      allow read: if true;
      allow write: if isAuth();
    }

    match /system_settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin() || isDispatcher();
    }

    match /admin_config/{docId} {
      allow read, write: if isAdmin();
    }

    match /sub_admins/{docId} {
      allow read, write: if isAdmin();
    }

    match /banners/{docId} {
      allow read: if true;
      allow write: if isAdmin() || isDispatcher();
    }

    match /promotions/{docId} {
      allow read: if true;
      allow write: if isAdmin() || isDispatcher();
    }

    match /appContent/{docId} {
      allow read: if true;
      allow write: if isAdmin() || isDispatcher();
    }

    match /site_content/{docId} {
      allow read: if true;
      allow write: if isAdmin() || isDispatcher();
    }

    match /cms_services/{docId} {
      allow read: if true;
      allow write: if isAdmin() || isDispatcher();
    }

    match /cms_team/{docId} {
      allow read: if true;
      allow write: if isAdmin() || isDispatcher();
    }

    match /cms_testimonials/{docId} {
      allow read: if true;
      allow write: if isAdmin() || isDispatcher();
    }

    match /cms_blog/{docId} {
      allow read: if true;
      allow write: if isAdmin() || isDispatcher();
    }

    match /cms_portfolio/{docId} {
      allow read: if true;
      allow write: if isAdmin() || isDispatcher();
    }

    // =========================================================
    // NOTIFICATIONS, BROADCASTS & AUDIT LOGS
    // =========================================================

    match /notifications/{docId} {
      allow read, write: if isAuth();
      allow delete: if isAdmin();
    }

    match /broadcast_news/{docId} {
      allow read: if isAuth() || true;
      allow write: if isAdmin() || isDispatcher();
    }

    match /audit_logs/{docId} {
      allow read: if isAdmin();
      allow create: if isAuth();
      allow update, delete: if false; // Immutable audit trail
    }

    // =========================================================
    // LOYALTY, REFERRALS & BATCH BOOKINGS
    // =========================================================

    match /customer_loyalty_points/{docId} {
      allow read, write: if isAuth();
      allow delete: if isAdmin();
    }

    match /referrals/{docId} {
      allow read, write: if isAuth();
      allow delete: if isAdmin();
    }

    match /referral_redemptions/{docId} {
      allow read, write: if isAuth();
      allow delete: if isAdmin();
    }

    match /batch_bookings/{batchId} {
      allow read, write: if isAuth();
      allow delete: if isAdmin();
    }

    match /batches/{batchId} {
      allow read, write: if isAuth();
      allow delete: if isAdmin();

      match /{allSubcollections=**} {
        allow read, write: if isAuth();
        allow delete: if isAdmin();
      }
    }

    match /offline_sync_logs/{docId} {
      allow read, write: if isAuth();
      allow delete: if isAdmin();
    }

    // =========================================================
    // PUBLIC FORM SUBMISSIONS (Contacts, Subscribers)
    // =========================================================

    match /contacts/{docId} {
      allow read: if isAdmin();
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    match /subscribers/{docId} {
      allow read: if isAdmin();
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    match /verification_otps/{docId} {
      allow read, write: if false; // Backend Cloud Functions only
    }
  }
}