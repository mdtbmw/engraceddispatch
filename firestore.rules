rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================
    // HELPERS
    // =========================================================

    function isAuth() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isAuth() && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin'
      );
    }

    function isAdmin() {
      return isAuth() && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin'
      );
    }

    // Dispatchers can read deliveries but NOT escalate their role or modify user roles
    function isDispatcher() {
      return isAuth() && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'dispatcher'
      );
    }

    function isOwner(userId) {
      return isAuth() && request.auth.uid == userId;
    }

    // Prevent non-admin from setting admin/super_admin role
    function notElevatingToAdmin() {
      return !request.resource.data.keys().hasAny(['role'])
        || request.resource.data.role in ['customer', 'rider', 'dispatcher'];
    }

    // Read size limit: deny reads of documents over 256 KiB
    function withinReadSizeLimit() {
      return resource.data.size() < 256 * 1024;
    }

    // Write size limit: deny writes of documents over 128 KiB
    function withinWriteSizeLimit() {
      return request.resource.data.size() < 128 * 1024;
    }

    // Rate limit: max 10 writes per minute per user (soft via doc size + existence checks)
    function isReasonableWrite() {
      return withinWriteSizeLimit()
        && request.resource.data.keys().size() <= 50;
    }

    // Validate contact/subscriber data to prevent abuse
    function isValidContact() {
      return request.resource.data.keys().hasAll(['name', 'email', 'message'])
        && request.resource.data.name is string
        && request.resource.data.email is string
        && request.resource.data.message is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 500
        && request.resource.data.email.size() > 0
        && request.resource.data.email.size() <= 320
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 5000;
    }

    function isValidSubscriber() {
      return request.resource.data.keys().hasAll(['email'])
        && request.resource.data.email is string
        && request.resource.data.email.size() > 0
        && request.resource.data.email.size() <= 320;
    }

    // =========================================================
    // USER PROFILES
    // =========================================================

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin() || isDispatcher();
      allow create: if isOwner(userId) && notElevatingToAdmin() && isReasonableWrite();
      allow update: if (isOwner(userId) && notElevatingToAdmin()) || isAdmin();
      allow delete: if isSuperAdmin();

      // Only super_admin can escalate to admin/super_admin
      allow update: if (isOwner(userId) && notElevatingToAdmin())
        || isSuperAdmin();

      match /notifications/{notifId} {
        allow read: if isOwner(userId);
        allow create: if isAdmin();
        allow update: if isOwner(userId) || isAdmin();
        allow delete: if isAdmin();
      }
      
      match /transactions/{transactionId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create, update, delete: if false; // Only allowed via backend Atomic db.runTransaction or Cloud Functions
      }

      match /deliveries/{deliveryId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create, update, delete: if isOwner(userId) || isAdmin();
      }
    }

    // =========================================================
    // FLEET LOCATIONS
    // =========================================================

    match /fleet_locations/{riderId} {
      allow read: if isAuth(); // Customers need to read it during tracking
      allow create, update: if isOwner(riderId) || isAdmin();
      allow delete: if isAdmin();
    }

    // =========================================================
    // DELIVERIES / SHIPMENTS
    // =========================================================

    match /deliveries/{deliveryId} {
      allow read: if isDispatcher() || isAdmin() || isOwner(resource.data.userId)
        || isOwner(resource.data.riderId);
      allow create: if isAuth() && isReasonableWrite();
      allow update: if isDispatcher() || isAdmin();
      allow delete: if isAdmin();
    }

    // =========================================================
    // PUBLIC-FACING CMS (read by anyone, written by admin)
    // =========================================================

    match /banners/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /promotions/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /appContent/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /site_content/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /system_config/{docId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    // =========================================================
    // CMS COLLECTIONS (service cards, team, testimonials, blog, portfolio)
    // =========================================================

    match /cms_services/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /cms_team/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /cms_testimonials/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /cms_blog/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /cms_portfolio/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // =========================================================
    // REFERRALS
    // =========================================================

    match /referrals/{docId} {
      allow read: if isAuth();
      allow create: if isAuth() && isReasonableWrite();
      allow update, delete: if isAdmin();
    }

    // =========================================================
    // NOTIFICATIONS
    // =========================================================

    match /notifications/{docId} {
      allow read: if isAuth()
        && (resource.data.userId == request.auth.uid
          || resource.data.userId == 'all'
          || resource.data.userId == null
          || isAdmin());
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // =========================================================
    // AUDIT LOGS
    // =========================================================

    match /audit_logs/{docId} {
      allow read: if isAdmin();
      allow create: if isAuth() && isReasonableWrite();
      allow update, delete: if isAdmin();
    }

    // =========================================================
    // PUBLIC FORM SUBMISSIONS (no auth required, validated)
    // =========================================================

    match /contacts/{docId} {
      allow read: if isAdmin();
      allow create: if isValidContact();
      allow update, delete: if isAdmin();
    }

    match /subscribers/{docId} {
      allow read: if isAdmin();
      allow create: if isValidSubscriber();
      allow update, delete: if isAdmin();
    }
  }
}
