rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================
    // HELPERS
    // =========================================================

    function isAuth() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isAuth() && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin'
      );
    }

    function isAdmin() {
      return isAuth() && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin'
      );
    }

    // Dispatchers can read/update deliveries but NOT escalate their role or modify user roles
    function isDispatcher() {
      return isAuth() && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'dispatcher'
      );
    }

    // A vendor is any authenticated user who owns a marketplace store
    function isVendor(userId) {
      return isAuth() && request.auth.uid == userId;
    }

    function isOwner(userId) {
      return isAuth() && request.auth.uid == userId;
    }

    // Prevent non-admin from changing their assigned role or elevating themselves
    function notElevatingRole() {
      return !request.resource.data.keys().hasAny(['role'])
        || (resource == null && request.resource.data.role == 'customer')
        || (resource != null && request.resource.data.role == resource.data.role);
    }

    // Soft field count limit to prevent bloated payloads
    function isReasonableWrite() {
      return request.resource.data.keys().size() <= 60;
    }

    // Validate contact/subscriber data to prevent abuse
    function isValidContact() {
      return request.resource.data.keys().hasAll(['name', 'email', 'message'])
        && request.resource.data.name is string
        && request.resource.data.email is string
        && request.resource.data.message is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 500
        && request.resource.data.email.size() > 0
        && request.resource.data.email.size() <= 320
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 5000;
    }

    function isValidSubscriber() {
      return request.resource.data.keys().hasAll(['email'])
        && request.resource.data.email is string
        && request.resource.data.email.size() > 0
        && request.resource.data.email.size() <= 320;
    }

    // =========================================================
    // USER PROFILES
    // =========================================================

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin() || isDispatcher();
      // Owner self-signup (default role customer) OR admin/dispatcher creating accounts for others
      allow create: if (isOwner(userId) && notElevatingRole() && isReasonableWrite())
        || isAdmin()
        || isDispatcher();
      // Update: owner (cannot change role or arbitrarily increase walletBalance/loyaltyPoints), admin (can promote/adjust), dispatcher (non-role fields only), or customer updating driver rating summary
      allow update: if (isOwner(userId) && notElevatingRole()
          && (
            // Either financial fields are untouched:
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['walletBalance', 'loyaltyPoints'])
            // OR valid initial one-time welcome gift claim:
            || (
              (!resource.data.keys().hasAny(['welcomeGiftClaimed']) || resource.data.welcomeGiftClaimed == false)
              && request.resource.data.welcomeGiftClaimed == true
              && request.resource.data.walletBalance == 2500.0
              && request.resource.data.loyaltyPoints == 100
            )
            // OR client spending/deduction where balances only decrement:
            || (
              (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['loyaltyPoints'])
                || (request.resource.data.loyaltyPoints <= resource.data.loyaltyPoints && request.resource.data.loyaltyPoints >= 0))
              && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['walletBalance'])
                || (request.resource.data.walletBalance <= resource.data.walletBalance && request.resource.data.walletBalance >= 0.0))
            )
          )
        )
        || isAdmin()
        || (isDispatcher() && !request.resource.data.keys().hasAny(['role', 'isOnline', 'walletBalance', 'loyaltyPoints']))
        || (isAuth() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating', 'ratingCount']));
      allow delete: if isSuperAdmin();

      match /ratings/{ratingId} {
        allow read: if true;
        allow create: if isAuth() && isReasonableWrite() && request.resource.data.customerId == request.auth.uid;
        allow update, delete: if isAdmin();
      }

      match /notifications/{notifId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isAdmin();
        allow update: if isOwner(userId) || isAdmin();
        allow delete: if isAdmin();
      }

      // Wallet ledger: written by the owning client under tight size limits until
      // a server-side Cloud Function backend is deployed.
      match /transactions/{transactionId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if (isOwner(userId) && isReasonableWrite()) || isAdmin();
        allow update, delete: if false;
      }

      // Cart persistence: only ever owned by the user
      match /cart/{itemId} {
        allow read, create, update, delete: if isOwner(userId) && isReasonableWrite();
      }

      // Verification OTP (owned by the user, time-limited)
      match /verification_otp/{docId} {
        allow read, write: if isOwner(userId) && isReasonableWrite();
      }

      // Tokenized payment cards (owned by user only)
      match /payment_cards/{cardId} {
        allow read, write, delete: if isOwner(userId) && isReasonableWrite();
      }

      // User Saved Address Book (owned by user only)
      match /addresses/{addressId} {
        allow read, write, delete: if isOwner(userId) && isReasonableWrite();
      }

      match /deliveries/{deliveryId} {
        allow read: if isOwner(userId) || isAdmin() || (isAuth() && resource.data.riderId == request.auth.uid);
        allow create, delete: if isOwner(userId) || isAdmin();
        allow update: if isOwner(userId) || isAdmin() || (isAuth() && (resource.data.riderId == request.auth.uid || request.resource.data.riderId == request.auth.uid));
      }
    }

    // =========================================================
    // FLEET LOCATIONS
    // =========================================================
    // Live GPS is private: readable only by the rider, admins and dispatchers.
    // Customers receive courier positions via the deliveries document instead.

    match /fleet_locations/{riderId} {
      allow read: if isAuth();
      allow create, update: if isOwner(riderId) || isAdmin();
      allow delete: if isAdmin();
    }

    // =========================================================
    // DELIVERIES / SHIPMENTS
    // =========================================================

    match /deliveries/{deliveryId} {
      // Publicly trackable by direct shipment ID (for SMS/web recipients)
      allow read: if true;
      allow create: if isAuth() && isReasonableWrite() && request.resource.data.userId == request.auth.uid
        || isDispatcher() || isAdmin();
      // Riders are permitted to advance their own deliveries (status/OTP/POD);
      // active riders can also claim an unassigned PENDING shipment.
      allow update: if isDispatcher() || isAdmin()
        || (isAuth() && (isOwner(resource.data.riderId) || isOwner(resource.data.userId)))
        || (isAuth() && resource.data.status == 'PENDING'
            && request.resource.data.status == 'ASSIGNED'
            && request.resource.data.riderId == request.auth.uid);
      allow delete: if isAdmin();

      match /chats/{chatId} {
        allow read: if true;
        allow create: if isAuth() && isReasonableWrite();
        allow update, delete: if isAdmin();
      }
    }

    // =========================================================
    // FLEET COMPLIANCE & ATTENDANCE
    // =========================================================

    match /rider_attendance/{docId} {
      allow read: if isAuth() && (isAdmin() || isDispatcher() || request.auth.uid == resource.data.riderId);
      allow create: if isAuth() && isReasonableWrite() && request.resource.data.riderId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /vehicle_inspections/{docId} {
      allow read: if isAuth() && (isAdmin() || isDispatcher() || request.auth.uid == resource.data.riderId);
      allow create: if isAuth() && isReasonableWrite() && request.resource.data.riderId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // =========================================================
    // PUBLIC-FACING CMS (read by anyone, written by admin)
    // =========================================================

    match /banners/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /promotions/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /appContent/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /site_content/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /system_config/{docId} {
      // App clients read feature/pricing config; secrets must never be stored here
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    // Admin-only secrets (FCM server key, webhook credentials). Never readable by app clients.
    match /admin_config/{docId} {
      allow read, write: if isAdmin();
    }

    // Sub-admin role/permission records managed by admins
    match /sub_admins/{docId} {
      allow read, write: if isAdmin();
    }

    // =========================================================
    // CMS COLLECTIONS (service cards, team, testimonials, blog, portfolio)
    // =========================================================

    match /cms_services/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /cms_team/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /cms_testimonials/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /cms_blog/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /cms_portfolio/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // =========================================================
    // REFERRALS
    // =========================================================

    match /referrals/{docId} {
      allow read: if isAuth();
      allow create: if isAuth() && isReasonableWrite();
      allow update, delete: if isAdmin();
    }

    match /referral_redemptions/{docId} {
      allow read: if isAuth() && (request.auth.uid == resource.data.userId || isAdmin());
      allow create: if isAuth() && isReasonableWrite()
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // =========================================================
    // NOTIFICATIONS
    // =========================================================

    match /notifications/{docId} {
      allow read: if isAuth()
        && (resource.data.userId == request.auth.uid
          || resource.data.userId == 'all'
          || resource.data.userId == null
          || isAdmin());
      allow create: if isAdmin();
      allow update: if isAdmin() || isOwner(resource.data.userId);
      allow delete: if isAdmin();
    }

    // =========================================================
    // AUDIT LOGS — only admins may record entries (anti-forgery)
    // =========================================================

    match /audit_logs/{docId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if isAdmin();
    }

    // =========================================================
    // CUSTOMER SUPPORT & DISPATCH LIVE CHATS
    // =========================================================

    match /support_chats/{ticketId} {
      allow read: if isAuth() && (ticketId == request.auth.uid || resource.data.userId == request.auth.uid || isAdmin() || isDispatcher());
      allow create: if isAuth() && isReasonableWrite() && (ticketId == request.auth.uid || request.resource.data.userId == request.auth.uid || isAdmin());
      allow update: if isAuth() && isReasonableWrite() && (ticketId == request.auth.uid || resource.data.userId == request.auth.uid || request.resource.data.userId == request.auth.uid || isAdmin() || isDispatcher());
      allow delete: if isAdmin();

      match /messages/{msgId} {
        allow read: if isAuth() && (
          ticketId == request.auth.uid ||
          resource.data.senderId == request.auth.uid ||
          (exists(/databases/$(database)/documents/support_chats/$(ticketId)) && get(/databases/$(database)/documents/support_chats/$(ticketId)).data.userId == request.auth.uid) ||
          isAdmin() ||
          isDispatcher()
        );
        allow create: if isAuth() && isReasonableWrite() && (
          ticketId == request.auth.uid ||
          request.resource.data.senderId == request.auth.uid ||
          (exists(/databases/$(database)/documents/support_chats/$(ticketId)) && get(/databases/$(database)/documents/support_chats/$(ticketId)).data.userId == request.auth.uid) ||
          isAdmin() ||
          isDispatcher()
        );
        allow update, delete: if isAdmin();
      }
    }

    // =========================================================
    // PUBLIC FORM SUBMISSIONS (no auth required, validated)
    // =========================================================

    match /contacts/{docId} {
      allow read: if isAdmin();
      allow create: if isValidContact();
      allow update, delete: if isAdmin();
    }

    match /subscribers/{docId} {
      allow read: if isAdmin();
      allow create: if isValidSubscriber();
      allow update, delete: if isAdmin();
    }

    // =========================================================
    // MARKETPLACE (Products, Stores, Orders, Payouts)
    // =========================================================

    match /marketplace_products/{docId} {
      allow read: if true; // Public catalog viewable by customers & vendors
      allow create: if isAdmin() || (isAuth() && request.resource.data.vendorId == request.auth.uid && isReasonableWrite());
      // Vendors edit their own products; any authenticated user may only adjust the stock field
      // (customer purchases). All other mutations require admin.
      allow update: if isAdmin()
        || (isAuth() && resource.data.vendorId == request.auth.uid && isReasonableWrite())
        || (isAuth() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock']));
      allow delete: if isAdmin() || (isAuth() && resource.data.vendorId == request.auth.uid);
    }

    match /marketplace_stores/{docId} {
      allow read: if true; // Public store directory
      // Vendors can create their own store (doc keyed by their uid via ownerId);
      // admins enlist stores on behalf of partner accounts.
      allow create: if isAuth() && request.resource.data.ownerId == request.auth.uid && isReasonableWrite()
        || isAdmin();
      allow update: if isAdmin()
        || (isAuth() && (resource.data.ownerId == request.auth.uid || resource.data.id == request.auth.uid) && isReasonableWrite());
      allow delete: if isAdmin() || (isAuth() && resource.data.ownerId == request.auth.uid);
    }

    match /marketplace_orders/{docId} {
      allow read: if isAuth() && (isAdmin() || resource.data.userId == request.auth.uid || resource.data.vendorId == request.auth.uid || resource.data.storeId == request.auth.uid);
      allow create: if isAuth() && isReasonableWrite() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Vendor payout requests: readable by the requester and admins, written by the requester only,
    // mutation (approve/reject) belongs to admins.
    match /vendor_payout_requests/{docId} {
      allow read: if isAuth() && (request.auth.uid == resource.data.vendorId || isAdmin());
      allow create: if isAuth() && isReasonableWrite() && request.resource.data.vendorId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // =========================================================
    // LOYALTY POINTS & LEGACY PARCEL MIRRORS
    // =========================================================

    match /customer_loyalty_points/{docId} {
      allow read: if isAuth();
      allow create, update: if isAuth() && isReasonableWrite();
      allow delete: if isAdmin();
    }

    match /parcels/{docId} {
      allow read: if true;
      allow create, update: if isAuth() && isReasonableWrite();
      allow delete: if isAdmin();
    }

    match /riders/{riderId} {
      allow read: if isAuth();
      allow write: if isAdmin() || isDispatcher();
    }

    match /system_ledger/{docId} {
      allow read: if isAdmin();
      allow write: if false; // System ledger mutations strictly reserved for Cloud Functions
    }

    match /verification_otps/{docId} {
      allow read, write: if false; // Verification OTPs strictly managed by Cloud Functions backend
    }

    match /system_settings/{settingId} {
      allow read: if isAuth() && (settingId != 'smtp' || isAdmin());
      allow write: if isAdmin();
    }
  }
}