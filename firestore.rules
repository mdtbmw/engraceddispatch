rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // ASSUMED DATA MODELS & SECURITY ARCHITECTURE
    // ===============================================================
    //
    // /users/{userId}
    //   - User profile with role-based access control (customer, rider, driver, vendor, dispatcher, admin, super_admin)
    //   - Public/authenticated read for storefront/courier roles: ['rider', 'driver', 'vendor']
    //   - Protected fields: role, userRole, admin, isSuperAdmin, permissions, walletBalance, pin, securityPin, email
    //   - Subcollections:
    //       /notifications: Inbox notifications created by authenticated users or dispatchers, readable by owner & admin
    //       /notification_events: Push/deduplication events
    //       /ratings & /reviews: Star ratings and feedback created by customers
    //       /cart: Shopping cart items for marketplace
    //       /deliveries: Scoped delivery history
    //       /addresses: Saved destination addresses
    //       /payment_cards: Saved payment methods
    //       /security_events: Security & login auditing
    //       /activity_logs: User session activity logs
    //       /transactions: Wallet ledger and transaction history
    //
    // /phone_indices/{phoneKey}
    //   - Digits-only unique phone registry document (e.g., 2348031234567)
    //   - Public read for real-time pre-signup uniqueness verification
    //   - Created atomically by owner UID; updated/deleted by owner UID or admin
    //
    // /deliveries/{deliveryId} & /parcels/{parcelId}
    //   - Central delivery tracking records
    //   - Read/list for participants (userId/senderId, riderId, assignedRiderId, driverId, reservedRiderId), dispatchers, admins, or unassigned/offered deliveries
    //   - Create by authenticated users
    //   - Update by participants, dispatchers, admins, or riders claiming available/pool deliveries
    //   - Subcollections: /messages, /timeline, /pod_events, /chats, /ratings
    //
    // /public_tracking/{deliveryId}
    //   - Public real-time shipment status & courier coordinates for recipient tracking links
    //   - Public read; write by assigned rider, customer, dispatcher, or admin
    //
    // /reviews/{reviewId} & /ratings/{ratingId}
    //   - Global feedback documents with public read, author create/edit, and admin moderation
    //
    // /rider_tips/{tipId}
    //   - Courier tip transactions created by customer, read by customer/rider/admin, managed by admin
    //
    // /transactions/{transactionId}, /tip_withdrawals/{withdrawalId}, /refund_requests/{requestId}, /vendor_payout_requests/{docId}
    //   - Financial ledger entries accessible to participants and administrative oversight
    //
    // /payout_settlements/{docId}, /system_ledger/{docId}, /settlement_records/{docId}
    //   - Internal accounting collections restricted to Admin/Dispatcher read and Cloud Functions write
    //
    // /fleet_locations/{riderId}, /rider_attendance/{docId}, /vehicle_inspections/{docId}, /drivers/{driverId}, /riders/{riderId}
    //   - Courier GPS telemetry and operational logs accessible to courier self and fleet dispatch/admin
    //
    // /support_chats/{ticketId} & /support_chats/{ticketId}/messages/{msgId}
    //   - Customer support tickets and messages accessible to ticket author, involved participants, and support staff
    //
    // /marketplace_products/{productId}, /marketplace_stores/{storeId}, /marketplace_orders/{orderId}
    //   - Storefront catalogs (public read), vendor shop management, and order lifecycle tracking
    //
    // /system_config, /system_settings, /admin_config, /sub_admins, /banners, /promotions, /appContent, /site_content, /cms_*
    //   - Public content for CMS/landing pages, administrative configuration for staff
    //
    // /notifications/{docId}, /broadcast_news/{docId}, /audit_logs/{docId}, /incident_reports/{docId}, /fleet_broadcasts/{docId}
    //   - Global broadcasts, incident reports, and immutable audit trails
    //
    // /customer_loyalty_points/{docId}, /referrals/{docId}, /referral_redemptions/{docId}, /batch_bookings/{batchId}, /batches/{batchId}, /offline_sync_logs/{docId}
    //   - User loyalty programs, batch dispatching, and offline cache synchronization
    //
    // /contacts/{docId}, /subscribers/{docId}, /verification_otps/{docId}
    //   - Landing page lead forms and secure OTP records
    //
    // /address_registry/{entryId}
    //   - Public landmarks and geocoded zones for instant landing page & booking fare calculations
    //
    // ===============================================================

    // ===============================================================
    // AUTHENTICATION & ADMINISTRATIVE HELPER FUNCTIONS
    // ===============================================================

    function isAuth() {
      return request.auth != null && request.auth.uid != null;
    }

    function isOwner(userId) {
      return isAuth() && request.auth.uid == userId;
    }

    function isSuperAdmin() {
      return isAuth() && (
        (request.auth.token.get('admin', false) == true) ||
        (request.auth.token.get('isSuperAdmin', false) == true) ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') in ['super_admin', 'SuperAdmin', 'Super_Admin', 'Super Admin', 'owner', 'Owner'] ||
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('userRole', '') in ['super_admin', 'SuperAdmin', 'Super_Admin', 'Super Admin', 'owner', 'Owner']
          )
        )
      );
    }

    function isAdmin() {
      return isAuth() && (
        isSuperAdmin() ||
        (request.auth.token.get('admin', false) == true) ||
        (request.auth.token.get('role', '') in ['admin', 'super_admin', 'dispatcher', 'manager', 'owner', 'Admin', 'SuperAdmin', 'Dispatcher', 'Manager', 'Owner']) ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') in ['admin', 'super_admin', 'Admin', 'SuperAdmin', 'Super_Admin', 'Super Admin', 'dispatcher', 'Dispatcher', 'manager', 'Manager', 'owner', 'Owner'] ||
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('userRole', '') in ['admin', 'super_admin', 'Admin', 'SuperAdmin', 'Super_Admin', 'Super Admin', 'dispatcher', 'Dispatcher', 'manager', 'Manager', 'owner', 'Owner']
          )
        )
      );
    }

    function isDispatcher() {
      return isAuth() && (
        isAdmin() ||
        (request.auth.token.get('role', '') in ['dispatcher', 'Dispatcher']) ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') in ['dispatcher', 'Dispatcher'] ||
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('userRole', '') in ['dispatcher', 'Dispatcher']
          )
        )
      );
    }

    function isDeliveryParticipant(data) {
      return isAuth() && (
        data.get('userId', '') == request.auth.uid ||
        data.get('senderId', '') == request.auth.uid ||
        data.get('riderId', '') == request.auth.uid ||
        data.get('assignedRiderId', '') == request.auth.uid ||
        data.get('driverId', '') == request.auth.uid ||
        data.get('reservedRiderId', '') == request.auth.uid
      );
    }

    function isAvailableDelivery(data) {
      return data.get('status', '') in [
        'PENDING', 'QUEUED', 'OFFERED', 'pending', 'queued',
        'AVAILABLE', 'available', 'UNASSIGNED', 'unassigned', 'ASSIGNED_TO_POOL'
      ];
    }

    function isReasonableWrite() {
      return request.resource.data.keys().size() <= 150;
    }

    // ===============================================================
    // USER PROFILES & SUBCOLLECTIONS
    // ===============================================================

    match /users/{userId} {
      // Allow public/authenticated read for user profiles with role in ['rider', 'driver', 'vendor']
      // so storefronts, vendor details, and rider cards display smoothly.
      // Owner, admin, and dispatcher can always read full profile.
      allow read: if isOwner(userId) || isAdmin() || isDispatcher() ||
        (resource.data.get('role', '') in ['rider', 'driver', 'vendor', 'RIDER', 'DRIVER', 'VENDOR'] ||
         resource.data.get('userRole', '') in ['rider', 'driver', 'vendor', 'RIDER', 'DRIVER', 'VENDOR']);

      // Prevent non-admin privilege escalation on creation
      allow create: if isAuth() && (
        isAdmin() ||
        (
          request.auth.uid == userId &&
          !request.resource.data.keys().hasAny(['admin', 'isSuperAdmin', 'permissions']) &&
          !request.resource.data.get('role', '') in ['admin', 'super_admin', 'dispatcher', 'manager', 'owner', 'Admin', 'SuperAdmin', 'Dispatcher', 'Manager', 'Owner'] &&
          !request.resource.data.get('userRole', '') in ['admin', 'super_admin', 'dispatcher', 'manager', 'owner', 'Admin', 'SuperAdmin', 'Dispatcher', 'Manager', 'Owner'] &&
          request.resource.data.get('walletBalance', 0) == 0
        )
      );

      // Protect sensitive fields against non-admin escalation on update
      allow update: if isAuth() && (
        isAdmin() ||
        (
          isOwner(userId) &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'role', 'userRole', 'admin', 'isSuperAdmin', 'permissions', 'walletBalance', 'email'
          ])
        )
      );

      allow delete: if isSuperAdmin();

      // Notifications inbox: any authenticated user (e.g., rider, customer, dispatcher) can post notifications; owner & admin manage them
      match /notifications/{notifId} {
        allow read, update, delete: if isOwner(userId) || isAdmin();
        allow create: if isAuth();
      }

      // Notification events deduplication records
      match /notification_events/{eventId} {
        allow read, update, delete: if isOwner(userId) || isAdmin();
        allow create: if isAuth();
      }

      // Ratings & reviews on user profiles
      match /ratings/{ratingId} {
        allow read: if true;
        allow create: if isAuth();
        allow update, delete: if isAuth() && (
          resource.data.get('userId', '') == request.auth.uid ||
          resource.data.get('customerId', '') == request.auth.uid ||
          isOwner(userId) ||
          isAdmin()
        );
      }

      match /reviews/{reviewId} {
        allow read: if true;
        allow create: if isAuth();
        allow update, delete: if isAuth() && (
          resource.data.get('userId', '') == request.auth.uid ||
          resource.data.get('customerId', '') == request.auth.uid ||
          isOwner(userId) ||
          isAdmin()
        );
      }

      // Marketplace shopping cart
      match /cart/{itemId} {
        allow read, write: if isOwner(userId) || isAdmin();
        allow delete: if isOwner(userId) || isAdmin();
      }

      // User scoped deliveries
      match /deliveries/{deliveryId} {
        allow read, write: if isOwner(userId) || isAdmin() || isDispatcher();
        allow delete: if isOwner(userId) || isAdmin();
      }

      // Saved delivery addresses
      match /addresses/{addressId} {
        allow read, write: if isOwner(userId) || isAdmin();
        allow delete: if isOwner(userId) || isAdmin();
      }

      // Saved payment cards
      match /payment_cards/{cardId} {
        allow read, write: if isOwner(userId) || isAdmin();
        allow delete: if isOwner(userId) || isAdmin();
      }

      // Security events and login logs
      match /security_events/{eventId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) || isAdmin();
        allow update, delete: if isAdmin();
      }

      // Activity logs
      match /activity_logs/{logId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) || isAdmin();
        allow update, delete: if isAdmin();
      }

      // User transaction ledger
      match /transactions/{txId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) || isAdmin();
        allow update, delete: if isAdmin();
      }

      // Scoped fallback for any other subcollections under /users/{userId}
      match /{allSubcollections=**} {
        allow read, write: if isOwner(userId) || isAdmin();
        allow delete: if isOwner(userId) || isSuperAdmin();
      }
    }

    // ===============================================================
    // PHONE NUMBER REGISTRY & STRICT UNIQUENESS INDEX
    // ===============================================================

    match /phone_indices/{phoneKey} {
      // Public read for real-time pre-signup phone availability check
      allow read: if true;

      // Authenticated users claim their phone key reservation
      allow create: if isAuth() && request.resource.data.get('uid', '') == request.auth.uid;

      // Only the reservation owner or admin can update or release
      allow update, delete: if isAuth() && (isAdmin() || resource.data.get('uid', '') == request.auth.uid);
    }

    // ===============================================================
    // DELIVERIES & PARCELS (Tracking, Ratings, Status, Chats)
    // ===============================================================

    match /deliveries/{deliveryId} {
      // Scoped access for participants, fleet dispatchers, admins, and pool deliveries
      allow get, list: if isAuth() && (
        isAdmin() ||
        isDispatcher() ||
        isDeliveryParticipant(resource.data) ||
        resource.data.get('receiverPhone', '') != '' ||
        isAvailableDelivery(resource.data)
      );

      allow create: if isAuth();

      // Participants, dispatchers, admins, and couriers claiming unassigned deliveries can update
      allow update: if isAuth() && (
        isAdmin() ||
        isDispatcher() ||
        isDeliveryParticipant(resource.data) ||
        isAvailableDelivery(resource.data)
      );

      allow delete: if isAdmin();

      // Delivery subcollections: messages, timeline events, chats, proof of delivery
      match /{allSubcollections=**} {
        allow read, write: if isAuth();
        allow delete: if isAdmin();
      }
    }

    match /parcels/{parcelId} {
      allow get, list: if isAuth() && (
        isAdmin() ||
        isDispatcher() ||
        isDeliveryParticipant(resource.data) ||
        resource.data.get('receiverPhone', '') != '' ||
        isAvailableDelivery(resource.data)
      );

      allow create: if isAuth();

      allow update: if isAuth() && (
        isAdmin() ||
        isDispatcher() ||
        isDeliveryParticipant(resource.data) ||
        isAvailableDelivery(resource.data)
      );

      allow delete: if isAdmin();

      match /{allSubcollections=**} {
        allow read, write: if isAuth();
        allow delete: if isAdmin();
      }
    }

    match /public_tracking/{deliveryId} {
      // Public read for recipients tracking orders via link
      allow read: if true;
      allow write: if isAuth() && (
        isAdmin() ||
        isDispatcher() ||
        request.resource.data.get('riderId', '') == request.auth.uid ||
        request.resource.data.get('userId', '') == request.auth.uid ||
        (resource != null && (
          resource.data.get('riderId', '') == request.auth.uid ||
          resource.data.get('userId', '') == request.auth.uid
        ))
      );

      match /{allSubcollections=**} {
        allow read: if true;
        allow write: if isAuth();
        allow delete: if isAdmin();
      }
    }

    // ===============================================================
    // REVIEWS & RATINGS (Root Collections)
    // ===============================================================

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isAuth() && (
        request.resource.data.get('userId', '') == request.auth.uid ||
        request.resource.data.get('customerId', '') == request.auth.uid ||
        request.resource.data.get('authorId', '') == request.auth.uid
      );
      allow update, delete: if isAuth() && (
        resource.data.get('userId', '') == request.auth.uid ||
        resource.data.get('customerId', '') == request.auth.uid ||
        resource.data.get('authorId', '') == request.auth.uid ||
        isAdmin()
      );

      match /{allSubcollections=**} {
        allow read: if true;
        allow write: if isAuth() && (
          resource.data.get('userId', '') == request.auth.uid ||
          resource.data.get('customerId', '') == request.auth.uid ||
          request.resource.data.get('userId', '') == request.auth.uid ||
          request.resource.data.get('customerId', '') == request.auth.uid ||
          isAdmin()
        );
        allow delete: if isAdmin();
      }
    }

    match /ratings/{ratingId} {
      allow read: if true;
      allow create: if isAuth() && (
        request.resource.data.get('userId', '') == request.auth.uid ||
        request.resource.data.get('customerId', '') == request.auth.uid ||
        request.resource.data.get('authorId', '') == request.auth.uid
      );
      allow update, delete: if isAuth() && (
        resource.data.get('userId', '') == request.auth.uid ||
        resource.data.get('customerId', '') == request.auth.uid ||
        resource.data.get('authorId', '') == request.auth.uid ||
        isAdmin()
      );

      match /{allSubcollections=**} {
        allow read: if true;
        allow write: if isAuth() && (
          resource.data.get('userId', '') == request.auth.uid ||
          resource.data.get('customerId', '') == request.auth.uid ||
          request.resource.data.get('userId', '') == request.auth.uid ||
          request.resource.data.get('customerId', '') == request.auth.uid ||
          isAdmin()
        );
        allow delete: if isAdmin();
      }
    }

    // ===============================================================
    // RIDER TIPS & GRATUITY RECORDS
    // ===============================================================

    match /rider_tips/{tipId} {
      allow read: if isAuth() && (
        isAdmin() ||
        resource.data.get('riderId', '') == request.auth.uid ||
        resource.data.get('customerId', '') == request.auth.uid ||
        resource.data.get('userId', '') == request.auth.uid
      );
      allow create: if isAuth() && (
        request.resource.data.get('customerId', '') == request.auth.uid ||
        request.resource.data.get('userId', '') == request.auth.uid
      );
      allow update, delete: if isAdmin();

      match /{allSubcollections=**} {
        allow read: if isAuth() && (
          isAdmin() ||
          resource.data.get('riderId', '') == request.auth.uid ||
          resource.data.get('customerId', '') == request.auth.uid ||
          resource.data.get('userId', '') == request.auth.uid
        );
        allow write, delete: if isAdmin();
      }
    }

    // ===============================================================
    // TRANSACTIONS, LEDGERS & WITHDRAWALS
    // ===============================================================

    match /transactions/{transactionId} {
      allow read: if isAuth() && (
        isAdmin() ||
        resource.data.get('userId', '') == request.auth.uid ||
        resource.data.get('riderId', '') == request.auth.uid
      );
      allow create: if isAuth() && (
        isAdmin() ||
        request.resource.data.get('userId', '') == request.auth.uid ||
        request.resource.data.get('riderId', '') == request.auth.uid
      );
      allow update, delete: if isAdmin();

      match /{allSubcollections=**} {
        allow read: if isAuth() && (isAdmin() || resource.data.get('userId', '') == request.auth.uid);
        allow write, delete: if isAdmin();
      }
    }

    match /tip_withdrawals/{withdrawalId} {
      allow read: if isAuth() && (
        isAdmin() ||
        resource.data.get('riderId', '') == request.auth.uid ||
        resource.data.get('userId', '') == request.auth.uid
      );
      allow create: if isAuth() && (
        request.resource.data.get('riderId', '') == request.auth.uid ||
        request.resource.data.get('userId', '') == request.auth.uid
      );
      allow update, delete: if isAdmin();

      match /{allSubcollections=**} {
        allow read: if isAuth() && (isAdmin() || resource.data.get('riderId', '') == request.auth.uid || resource.data.get('userId', '') == request.auth.uid);
        allow write, delete: if isAdmin();
      }
    }

    match /refund_requests/{requestId} {
      allow read: if isAuth() && (
        isAdmin() ||
        resource.data.get('userId', '') == request.auth.uid ||
        resource.data.get('customerId', '') == request.auth.uid
      );
      allow create: if isAuth() && (
        request.resource.data.get('userId', '') == request.auth.uid ||
        request.resource.data.get('customerId', '') == request.auth.uid
      );
      allow update, delete: if isAdmin();

      match /{allSubcollections=**} {
        allow read: if isAuth() && (isAdmin() || resource.data.get('userId', '') == request.auth.uid);
        allow write, delete: if isAdmin();
      }
    }

    match /vendor_payout_requests/{docId} {
      allow read: if isAuth() && (
        isAdmin() ||
        resource.data.get('vendorId', '') == request.auth.uid ||
        resource.data.get('userId', '') == request.auth.uid
      );
      allow create: if isAuth() && (
        request.resource.data.get('vendorId', '') == request.auth.uid ||
        request.resource.data.get('userId', '') == request.auth.uid
      );
      allow update, delete: if isAdmin();
    }

    match /payout_settlements/{docId} {
      allow read: if isAdmin();
      allow write: if false; // Cloud Functions only
    }

    match /system_ledger/{docId} {
      allow read: if isAdmin();
      allow write: if false; // Cloud Functions only
    }

    match /settlement_records/{docId} {
      allow read: if isAdmin() || isDispatcher();
      allow write: if false; // Cloud Functions only
    }

    // ===============================================================
    // FLEET LOCATIONS, ATTENDANCE & TELEMETRY
    // ===============================================================

    match /fleet_locations/{riderId} {
      allow read: if isAuth();
      allow write: if isAuth() && (request.auth.uid == riderId || isAdmin() || isDispatcher());
      allow delete: if isAdmin();
    }

    match /rider_attendance/{docId} {
      allow read: if isAuth() && (
        isAdmin() ||
        isDispatcher() ||
        resource.data.get('riderId', '') == request.auth.uid ||
        resource.data.get('userId', '') == request.auth.uid
      );
      allow create: if isAuth() && (
        isAdmin() ||
        isDispatcher() ||
        request.resource.data.get('riderId', '') == request.auth.uid ||
        request.resource.data.get('userId', '') == request.auth.uid
      );
      allow update, delete: if isAdmin() || isDispatcher();
    }

    match /vehicle_inspections/{docId} {
      allow read: if isAuth() && (
        isAdmin() ||
        isDispatcher() ||
        resource.data.get('riderId', '') == request.auth.uid ||
        resource.data.get('driverId', '') == request.auth.uid ||
        resource.data.get('userId', '') == request.auth.uid
      );
      allow create: if isAuth() && (
        isAdmin() ||
        isDispatcher() ||
        request.resource.data.get('riderId', '') == request.auth.uid ||
        request.resource.data.get('driverId', '') == request.auth.uid ||
        request.resource.data.get('userId', '') == request.auth.uid
      );
      allow update, delete: if isAdmin() || isDispatcher();
    }

    match /drivers/{driverId} {
      allow read: if isAuth();
      allow create: if isAuth() && (request.auth.uid == driverId || isAdmin());
      allow update: if isAuth() && (request.auth.uid == driverId || isAdmin());
      allow delete: if isAdmin();

      match /{allSubcollections=**} {
        allow read, write: if isAuth() && (request.auth.uid == driverId || isAdmin());
        allow delete: if isAdmin();
      }
    }

    match /riders/{riderId} {
      allow read: if isAuth();
      allow create: if isAuth() && (request.auth.uid == riderId || isAdmin());
      allow update: if isAuth() && (request.auth.uid == riderId || isAdmin());
      allow delete: if isAdmin();

      match /{allSubcollections=**} {
        allow read, write: if isAuth() && (request.auth.uid == riderId || isAdmin());
        allow delete: if isAdmin();
      }
    }

    // ===============================================================
    // SUPPORT & DISPUTE CHATS
    // ===============================================================

    match /support_chats/{ticketId} {
      allow read: if isAuth() && (
        isAdmin() ||
        isDispatcher() ||
        resource.data.get('userId', '') == request.auth.uid ||
        resource.data.get('customerId', '') == request.auth.uid ||
        resource.data.get('riderId', '') == request.auth.uid
      );
      allow create: if isAuth();
      allow update: if isAuth() && (
        isAdmin() ||
        isDispatcher() ||
        resource.data.get('userId', '') == request.auth.uid ||
        resource.data.get('customerId', '') == request.auth.uid ||
        resource.data.get('riderId', '') == request.auth.uid
      );
      allow delete: if isAdmin();

      match /messages/{msgId} {
        allow read, write: if isAuth();
        allow delete: if isAdmin();
      }

      match /{allSubcollections=**} {
        allow read, write: if isAuth();
        allow delete: if isAdmin();
      }
    }

    // ===============================================================
    // MARKETPLACE (Products, Stores, Orders)
    // ===============================================================

    match /marketplace_products/{productId} {
      allow read: if true;
      allow create: if isAuth();
      allow update, delete: if isAuth() && (
        resource.data.get('vendorId', '') == request.auth.uid ||
        resource.data.get('storeOwnerId', '') == request.auth.uid ||
        isAdmin()
      );

      match /{allSubcollections=**} {
        allow read: if true;
        allow write: if isAuth();
        allow delete: if isAdmin();
      }
    }

    match /marketplace_stores/{storeId} {
      allow read: if true;
      allow create: if isAuth();
      allow update, delete: if isAuth() && (
        resource.data.get('ownerId', '') == request.auth.uid ||
        resource.data.get('vendorId', '') == request.auth.uid ||
        isAdmin()
      );

      match /{allSubcollections=**} {
        allow read: if true;
        allow write: if isAuth();
        allow delete: if isAdmin();
      }
    }

    match /marketplace_orders/{orderId} {
      allow read: if isAuth() && (
        isAdmin() ||
        isDispatcher() ||
        resource.data.get('buyerId', '') == request.auth.uid ||
        resource.data.get('userId', '') == request.auth.uid ||
        resource.data.get('customerId', '') == request.auth.uid ||
        resource.data.get('vendorId', '') == request.auth.uid ||
        resource.data.get('storeOwnerId', '') == request.auth.uid ||
        resource.data.get('riderId', '') == request.auth.uid
      );
      allow create: if isAuth();
      allow update: if isAuth() && (
        isAdmin() ||
        isDispatcher() ||
        resource.data.get('buyerId', '') == request.auth.uid ||
        resource.data.get('userId', '') == request.auth.uid ||
        resource.data.get('customerId', '') == request.auth.uid ||
        resource.data.get('vendorId', '') == request.auth.uid ||
        resource.data.get('storeOwnerId', '') == request.auth.uid ||
        resource.data.get('riderId', '') == request.auth.uid
      );
      allow delete: if isAdmin();

      match /{allSubcollections=**} {
        allow read, write: if isAuth();
        allow delete: if isAdmin();
      }
    }

    // ===============================================================
    // SYSTEM CONFIG, SETTINGS & CMS
    // ===============================================================

    match /system_config/{docId} {
      allow read: if true;
      allow write: if isAdmin() || isDispatcher();
    }

    match /system_settings/{settingId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /admin_config/{docId} {
      allow read, write: if isAdmin();
    }

    match /sub_admins/{docId} {
      allow read: if isAuth() && (isAdmin() || isDispatcher());
      allow write: if isAdmin();
    }

    match /banners/{docId} {
      allow read: if true;
      allow write: if isAdmin() || isDispatcher();
    }

    match /promotions/{docId} {
      allow read: if true;
      allow write: if isAdmin() || isDispatcher();
    }

    match /appContent/{docId} {
      allow read: if true;
      allow write: if isAdmin() || isDispatcher();
    }

    match /site_content/{docId} {
      allow read: if true;
      allow write: if isAdmin() || isDispatcher();
    }

    match /cms_services/{docId} {
      allow read: if true;
      allow write: if isAdmin() || isDispatcher();
    }

    match /cms_team/{docId} {
      allow read: if true;
      allow write: if isAdmin() || isDispatcher();
    }

    match /cms_testimonials/{docId} {
      allow read: if true;
      allow write: if isAdmin() || isDispatcher();
    }

    match /cms_blog/{docId} {
      allow read: if true;
      allow write: if isAdmin() || isDispatcher();
    }

    match /cms_portfolio/{docId} {
      allow read: if true;
      allow write: if isAdmin() || isDispatcher();
    }

    // ===============================================================
    // NOTIFICATIONS, BROADCASTS & AUDIT LOGS
    // ===============================================================

    match /notifications/{docId} {
      allow read: if isAuth() && (
        isAdmin() ||
        resource.data.get('userId', '') == request.auth.uid ||
        resource.data.get('targetUserId', '') == request.auth.uid ||
        resource.data.get('recipientId', '') == request.auth.uid
      );
      allow create: if isAuth();
      allow update: if isAuth() && (
        isAdmin() ||
        resource.data.get('userId', '') == request.auth.uid ||
        resource.data.get('targetUserId', '') == request.auth.uid ||
        resource.data.get('recipientId', '') == request.auth.uid
      );
      allow delete: if isAdmin();
    }

    match /broadcast_news/{docId} {
      allow read: if isAuth();
      allow write: if isAdmin() || isDispatcher();
    }

    match /audit_logs/{docId} {
      allow read: if isAdmin();
      allow create: if isAuth() && (
        isAdmin() ||
        request.resource.data.get('userId', '') == request.auth.uid ||
        request.resource.data.get('actorId', '') == request.auth.uid
      );
      allow update, delete: if false; // Immutable audit trail
    }

    match /incident_reports/{docId} {
      allow read: if isAuth() && (
        isAdmin() ||
        isDispatcher() ||
        resource.data.get('reporterId', '') == request.auth.uid ||
        resource.data.get('riderId', '') == request.auth.uid ||
        resource.data.get('userId', '') == request.auth.uid
      );
      allow create: if isAuth();
      allow update: if isAuth() && (
        isAdmin() ||
        isDispatcher() ||
        resource.data.get('reporterId', '') == request.auth.uid
      );
      allow delete: if isAdmin();
    }

    match /fleet_broadcasts/{docId} {
      allow read: if isAuth();
      allow write: if isAdmin() || isDispatcher();
    }

    // ===============================================================
    // LOYALTY, REFERRALS & BATCH BOOKINGS
    // ===============================================================

    match /customer_loyalty_points/{docId} {
      allow read: if isAuth() && (isAdmin() || resource.data.get('userId', '') == request.auth.uid);
      allow write: if isAuth() && (isAdmin() || resource.data.get('userId', '') == request.auth.uid);
      allow delete: if isAdmin();
    }

    match /referrals/{docId} {
      allow read: if isAuth();
      allow write: if isAuth();
      allow delete: if isAdmin();
    }

    match /referral_redemptions/{docId} {
      allow read: if isAuth();
      allow write: if isAuth();
      allow delete: if isAdmin();
    }

    match /batch_bookings/{batchId} {
      allow read: if isAuth() && (
        isAdmin() ||
        isDispatcher() ||
        resource.data.get('userId', '') == request.auth.uid
      );
      allow create: if isAuth();
      allow update: if isAuth() && (
        isAdmin() ||
        isDispatcher() ||
        resource.data.get('userId', '') == request.auth.uid
      );
      allow delete: if isAdmin();
    }

    match /batches/{batchId} {
      allow read: if isAuth() && (
        isAdmin() ||
        isDispatcher() ||
        resource.data.get('userId', '') == request.auth.uid
      );
      allow create: if isAuth();
      allow update: if isAuth() && (
        isAdmin() ||
        isDispatcher() ||
        resource.data.get('userId', '') == request.auth.uid
      );
      allow delete: if isAdmin();

      match /{allSubcollections=**} {
        allow read, write: if isAuth();
        allow delete: if isAdmin();
      }
    }

    match /offline_sync_logs/{docId} {
      allow read, write: if isAuth();
      allow delete: if isAdmin();
    }

    // ===============================================================
    // PUBLIC FORM SUBMISSIONS & OTP VERIFICATION
    // ===============================================================

    match /contacts/{docId} {
      allow read: if isAdmin();
      allow create: if isReasonableWrite() && request.resource.data.keys().hasAll(['name', 'email', 'message']);
      allow update, delete: if isAdmin();
    }

    match /subscribers/{docId} {
      allow read: if isAdmin();
      allow create: if isReasonableWrite() && request.resource.data.keys().hasAll(['email']);
      allow update, delete: if isAdmin();
    }

    match /verification_otps/{docId} {
      allow read, write: if false; // Backend Cloud Functions Admin SDK only
    }

    // ===============================================================
    // ADDRESS & LANDMARK REGISTRY
    // ===============================================================

    match /address_registry/{entryId} {
      // Public read so landing page fare estimates and app booking landmarks resolve immediately
      allow read: if true;
      // Coordinates and registry landmarks are managed exclusively by admin/dispatcher
      allow write: if isAdmin() || isDispatcher();
    }
  }
}