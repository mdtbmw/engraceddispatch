rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================
    // AUTHENTICATION & ADMINISTRATIVE PREDICATES
    // =========================================================

    function isAuth() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isAuth() && (
        (request.auth.token.keys().hasAny(['admin']) && request.auth.token.admin == true) ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') in ['super_admin', 'SuperAdmin', 'Super_Admin', 'Super Admin', 'owner', 'Owner'] ||
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('userRole', '') in ['super_admin', 'SuperAdmin', 'Super_Admin', 'Super Admin', 'owner', 'Owner']
          )
        )
      );
    }

    function isAdmin() {
      return isAuth() && (
        isSuperAdmin() ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') in ['admin', 'super_admin', 'Admin', 'SuperAdmin', 'Super_Admin', 'Super Admin', 'dispatcher', 'Dispatcher', 'manager', 'Manager', 'owner', 'Owner'] ||
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('userRole', '') in ['admin', 'super_admin', 'Admin', 'SuperAdmin', 'Super_Admin', 'Super Admin', 'dispatcher', 'Dispatcher', 'manager', 'Manager', 'owner', 'Owner']
          )
        )
      );
    }

    function isDispatcher() {
      return isAuth() && (
        isAdmin() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') in ['dispatcher', 'Dispatcher'])
      );
    }

    function isOwner(userId) {
      return isAuth() && request.auth.uid == userId;
    }

    function isReasonableWrite() {
      return request.resource.data.keys().size() <= 100;
    }

    // =========================================================
    // USER PROFILES & SUBCOLLECTIONS (Tipping, Ratings, Wallets)
    // =========================================================

    match /users/{userId} {
      allow read: if isAuth();
      allow create: if isAuth() && request.auth.uid == userId &&
        !request.resource.data.keys().hasAny(['role', 'userRole', 'admin', 'isSuperAdmin', 'permissions', 'walletBalance']);

      // Protect against privilege escalation and balance tampering
      allow update: if isAuth() && (
        isAdmin() ||
        (
          isOwner(userId) &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'role', 'userRole', 'admin', 'isSuperAdmin', 'permissions', 'walletBalance', 'pin', 'securityPin', 'email'
          ])
        ) ||
        // Allow courier tipping / rating / review count updates from authenticated customers
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'rating', 'totalRatings', 'ratingsCount', 'tipAmount', 'totalTips', 'lastRatedAt', 'reviewsCount'
        ])
      );

      allow delete: if isSuperAdmin();

      // Scoped subcollections under /users/{userId} (transactions, ratings, reviews, cart, deliveries, addresses)
      match /{allSubcollections=**} {
        allow read, write: if isOwner(userId) || isAdmin();
        allow delete: if isOwner(userId) || isSuperAdmin();
      }
    }

    // =========================================================
    // DELIVERIES & PARCELS (Tracking, Ratings, Status, Chats)
    // =========================================================

    match /deliveries/{deliveryId} {
      // Public single-document get for tracking by waybill / doc ID; authenticated listing
      allow get: if true;
      allow list: if isAuth();

      allow create: if isAuth();
      allow update: if isAuth() && (
        isAdmin() ||
        resource.data.userId == request.auth.uid ||
        resource.data.senderId == request.auth.uid ||
        resource.data.riderId == request.auth.uid ||
        resource.data.assignedRiderId == request.auth.uid ||
        resource.data.driverId == request.auth.uid
      );
      allow delete: if isAdmin();

      match /{allSubcollections=**} {
        allow read, write: if isAuth();
        allow delete: if isAdmin();
      }
    }

    match /parcels/{parcelId} {
      allow get: if true;
      allow list: if isAuth();

      allow create: if isAuth();
      allow update: if isAuth() && (
        isAdmin() ||
        resource.data.userId == request.auth.uid ||
        resource.data.senderId == request.auth.uid ||
        resource.data.riderId == request.auth.uid ||
        resource.data.assignedRiderId == request.auth.uid ||
        resource.data.driverId == request.auth.uid
      );
      allow delete: if isAdmin();

      match /{allSubcollections=**} {
        allow read, write: if isAuth();
        allow delete: if isAdmin();
      }
    }

    match /public_tracking/{deliveryId} {
      allow read: if true;
      allow write: if isAuth() && (
        isAdmin() ||
        resource.data.riderId == request.auth.uid ||
        request.resource.data.riderId == request.auth.uid
      );
    }

    // =========================================================
    // REVIEWS & RATINGS (Root Collections)
    // =========================================================

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isAuth();
      allow update, delete: if isAuth() && (resource.data.userId == request.auth.uid || isAdmin());

      match /{allSubcollections=**} {
        allow read, write: if isAuth();
        allow delete: if isAdmin();
      }
    }

    match /ratings/{ratingId} {
      allow read: if true;
      allow create: if isAuth();
      allow update, delete: if isAuth() && (resource.data.userId == request.auth.uid || isAdmin());

      match /{allSubcollections=**} {
        allow read, write: if isAuth();
        allow delete: if isAdmin();
      }
    }

    // =========================================================
    // TRANSACTIONS, LEDGERS & WITHDRAWALS
    // =========================================================

    match /transactions/{transactionId} {
      allow read: if isAuth() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow create: if isAuth() && (isAdmin() || request.resource.data.userId == request.auth.uid);
      allow update: if isAdmin();
      allow delete: if isAdmin();

      match /{allSubcollections=**} {
        allow read: if isAuth() && (isAdmin() || resource.data.userId == request.auth.uid);
        allow write: if isAdmin();
        allow delete: if isAdmin();
      }
    }

    match /tip_withdrawals/{withdrawalId} {
      allow read: if isAuth() && (isAdmin() || resource.data.riderId == request.auth.uid || resource.data.userId == request.auth.uid);
      allow create: if isAuth() && (request.resource.data.riderId == request.auth.uid || request.resource.data.userId == request.auth.uid);
      allow update: if isAdmin();
      allow delete: if isAdmin();

      match /{allSubcollections=**} {
        allow read: if isAuth() && (isAdmin() || resource.data.userId == request.auth.uid);
        allow write: if isAdmin();
        allow delete: if isAdmin();
      }
    }

    match /refund_requests/{requestId} {
      allow read: if isAuth() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();

      match /{allSubcollections=**} {
        allow read: if isAuth() && (isAdmin() || resource.data.userId == request.auth.uid);
        allow write: if isAdmin();
        allow delete: if isAdmin();
      }
    }

    match /vendor_payout_requests/{docId} {
      allow read: if isAuth() && (isAdmin() || resource.data.vendorId == request.auth.uid);
      allow create: if isAuth() && request.resource.data.vendorId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /payout_settlements/{docId} {
      allow read: if isAdmin();
      allow write: if false; // Cloud Functions only
    }

    match /system_ledger/{docId} {
      allow read: if isAdmin();
      allow write: if false; // Cloud Functions only
    }

    // =========================================================
    // FLEET LOCATIONS, ATTENDANCE & TELEMETRY
    // =========================================================

    match /fleet_locations/{riderId} {
      allow read: if isAuth();
      allow write: if isAuth() && (request.auth.uid == riderId || isAdmin());
      allow delete: if isAdmin();
    }

    match /rider_attendance/{docId} {
      allow read: if isAuth() && (isAdmin() || resource.data.riderId == request.auth.uid);
      allow create: if isAuth() && (isAdmin() || request.resource.data.riderId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /vehicle_inspections/{docId} {
      allow read: if isAuth() && (isAdmin() || resource.data.riderId == request.auth.uid);
      allow create: if isAuth() && (isAdmin() || request.resource.data.riderId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /drivers/{driverId} {
      allow read: if isAuth();
      allow create: if isAuth() && (request.auth.uid == driverId || isAdmin());
      allow update: if isAuth() && (request.auth.uid == driverId || isAdmin());
      allow delete: if isAdmin();

      match /{allSubcollections=**} {
        allow read, write: if isAuth() && (request.auth.uid == driverId || isAdmin());
        allow delete: if isAdmin();
      }
    }

    match /riders/{riderId} {
      allow read: if isAuth();
      allow create: if isAuth() && (request.auth.uid == riderId || isAdmin());
      allow update: if isAuth() && (request.auth.uid == riderId || isAdmin());
      allow delete: if isAdmin();

      match /{allSubcollections=**} {
        allow read, write: if isAuth() && (request.auth.uid == riderId || isAdmin());
        allow delete: if isAdmin();
      }
    }

    // =========================================================
    // SUPPORT & DISPUTE CHATS
    // =========================================================

    match /support_chats/{ticketId} {
      allow read: if isAuth() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow create: if isAuth() && (isAdmin() || request.resource.data.userId == request.auth.uid);
      allow update: if isAuth() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow delete: if isAdmin();

      match /{allSubcollections=**} {
        allow read, write: if isAuth();
        allow delete: if isAdmin();
      }
    }

    // =========================================================
    // MARKETPLACE (Products, Stores, Orders)
    // =========================================================

    match /marketplace_products/{productId} {
      allow read: if true;
      allow create: if isAuth();
      allow update, delete: if isAuth() && (resource.data.vendorId == request.auth.uid || isAdmin());

      match /{allSubcollections=**} {
        allow read: if true;
        allow write: if isAuth();
        allow delete: if isAdmin();
      }
    }

    match /marketplace_stores/{storeId} {
      allow read: if true;
      allow create: if isAuth();
      allow update, delete: if isAuth() && (resource.data.ownerId == request.auth.uid || resource.data.vendorId == request.auth.uid || isAdmin());

      match /{allSubcollections=**} {
        allow read: if true;
        allow write: if isAuth();
        allow delete: if isAdmin();
      }
    }

    match /marketplace_orders/{orderId} {
      allow read: if isAuth() && (
        isAdmin() ||
        resource.data.buyerId == request.auth.uid ||
        resource.data.userId == request.auth.uid ||
        resource.data.vendorId == request.auth.uid
      );
      allow create: if isAuth();
      allow update: if isAuth() && (
        isAdmin() ||
        resource.data.buyerId == request.auth.uid ||
        resource.data.vendorId == request.auth.uid
      );
      allow delete: if isAdmin();

      match /{allSubcollections=**} {
        allow read, write: if isAuth();
        allow delete: if isAdmin();
      }
    }

    // =========================================================
    // SYSTEM CONFIG, SETTINGS & CMS
    // =========================================================

    match /system_config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /system_settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /admin_config/{docId} {
      allow read, write: if isAdmin();
    }

    match /sub_admins/{docId} {
      allow read, write: if isAdmin();
    }

    match /banners/{docId} {
      allow read: if true;
      allow write: if isAdmin() || isDispatcher();
    }

    match /promotions/{docId} {
      allow read: if true;
      allow write: if isAdmin() || isDispatcher();
    }

    match /appContent/{docId} {
      allow read: if true;
      allow write: if isAdmin() || isDispatcher();
    }

    match /site_content/{docId} {
      allow read: if true;
      allow write: if isAdmin() || isDispatcher();
    }

    match /cms_services/{docId} {
      allow read: if true;
      allow write: if isAdmin() || isDispatcher();
    }

    match /cms_team/{docId} {
      allow read: if true;
      allow write: if isAdmin() || isDispatcher();
    }

    match /cms_testimonials/{docId} {
      allow read: if true;
      allow write: if isAdmin() || isDispatcher();
    }

    match /cms_blog/{docId} {
      allow read: if true;
      allow write: if isAdmin() || isDispatcher();
    }

    match /cms_portfolio/{docId} {
      allow read: if true;
      allow write: if isAdmin() || isDispatcher();
    }

    // =========================================================
    // NOTIFICATIONS, BROADCASTS & AUDIT LOGS
    // =========================================================

    match /notifications/{docId} {
      allow read: if isAuth() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow create: if isAuth();
      allow update: if isAuth() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow delete: if isAdmin();
    }

    match /broadcast_news/{docId} {
      allow read: if isAuth();
      allow write: if isAdmin() || isDispatcher();
    }

    match /audit_logs/{docId} {
      allow read: if isAdmin();
      allow create: if isAuth() && (isAdmin() || request.resource.data.userId == request.auth.uid);
      allow update, delete: if false; // Immutable audit trail
    }

    match /incident_reports/{docId} {
      allow read: if isAuth() && (isAdmin() || resource.data.reporterId == request.auth.uid || resource.data.riderId == request.auth.uid);
      allow create: if isAuth();
      allow update: if isAuth() && (isAdmin() || resource.data.reporterId == request.auth.uid);
      allow delete: if isAdmin();
    }

    match /fleet_broadcasts/{docId} {
      allow read: if isAuth();
      allow write: if isAdmin() || isDispatcher();
    }

    // =========================================================
    // LOYALTY, REFERRALS & BATCH BOOKINGS
    // =========================================================

    match /customer_loyalty_points/{docId} {
      allow read: if isAuth() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow write: if isAuth() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow delete: if isAdmin();
    }

    match /referrals/{docId} {
      allow read: if isAuth();
      allow write: if isAuth();
      allow delete: if isAdmin();
    }

    match /referral_redemptions/{docId} {
      allow read: if isAuth();
      allow write: if isAuth();
      allow delete: if isAdmin();
    }

    match /batch_bookings/{batchId} {
      allow read: if isAuth() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow create: if isAuth();
      allow update: if isAuth() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow delete: if isAdmin();
    }

    match /batches/{batchId} {
      allow read: if isAuth() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow create: if isAuth();
      allow update: if isAuth() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow delete: if isAdmin();

      match /{allSubcollections=**} {
        allow read, write: if isAuth();
        allow delete: if isAdmin();
      }
    }

    match /offline_sync_logs/{docId} {
      allow read, write: if isAuth();
      allow delete: if isAdmin();
    }

    // =========================================================
    // PUBLIC FORM SUBMISSIONS (Contacts, Subscribers)
    // =========================================================

    match /contacts/{docId} {
      allow read: if isAdmin();
      allow create: if isReasonableWrite() && request.resource.data.keys().hasAll(['name', 'email', 'message']);
      allow update, delete: if isAdmin();
    }

    match /subscribers/{docId} {
      allow read: if isAdmin();
      allow create: if isReasonableWrite() && request.resource.data.keys().hasAll(['email']);
      allow update, delete: if isAdmin();
    }

    match /verification_otps/{docId} {
      allow read, write: if false; // Backend Cloud Functions only
    }
  }
}