<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude local offline database containing delivery/customer records and sensitive auth tokens -->
        <exclude domain="database" path="."/>
        <exclude domain="sharedpref" path="esdispatch_auth_session.xml"/>
        <exclude domain="sharedpref" path="secure_vault_prefs.xml"/>
    </cloud-backup>
    <device-transfer>
        <!-- Exclude local cached database and auth tokens -->
        <exclude domain="database" path="."/>
        <exclude domain="sharedpref" path="esdispatch_auth_session.xml"/>
        <exclude domain="sharedpref" path="secure_vault_prefs.xml"/>
    </device-transfer>
</data-extraction-rules>
