rules_version = '2';
// Firebase Storage security rules for ESDispatch app assets.
// Uploads are scoped to the authenticated owner; public gallery reads are allowed.

service firebase.storage {
  match /b/{bucket}/o {
    // Profile avatars (btw: publicly needed for web/chat/review avatars)
    match /avatars/{userId}/{file} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Marketplace store assets (logo/cover) — keyed by the store owner uid
    match /store-assets/{storeId}/{file} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == storeId;
    }

    // Proof-of-delivery photos & signatures — visible to authenticated users,
    // writable by authenticated riders/users (max 10MB per asset)
    match /pod/{deliveryId}/{file} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.resource.size < 10 * 1024 * 1024;
    }

    // Incident/SOS evidence photos
    match /incidents/{riderId}/{file} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == riderId;
    }
  }
}