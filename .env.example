# ENGRACED DISPATCH - Environment Template
# Copy this file to .env and fill in your values.
# Used by: Android app (Secrets Gradle Plugin -> BuildConfig.*)
#           Next.js / Vite admin

# --- Firebase Core ---
FIREBASE_API_KEY=
FIREBASE_APPLICATION_ID=
FIREBASE_PROJECT_ID=
FIREBASE_DATABASE_URL=
FIREBASE_GCM_SENDER_ID=
FIREBASE_STORAGE_BUCKET=

# --- Google Maps Platform ---
GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_API_KEY=

# --- Firebase Phone Auth / OTP Token ---
FIREBASE_PHONE_AUTH_VERIFICATION_TOKEN=

# --- Android-only (baked into APK via BuildConfig) ---
MAPBOX_ACCESS_TOKEN=
GEMINI_API_KEY=
GOOGLE_WEB_CLIENT_ID=
PAYSTACK_PUBLIC_KEY=

# --- Web Admin (NEXT_PUBLIC_* or VITE_* exposed to browser) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_APPLICATION_ID=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=
NEXT_PUBLIC_FIREBASE_GCM_SENDER_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_GOOGLE_WEB_CLIENT_ID=
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_APPLICATION_ID=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
